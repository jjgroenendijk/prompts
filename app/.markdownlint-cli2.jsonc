{
  // Markdown lint for the whole repo. Config lives here, not in the root,
  // because the repo AGENTS.md keeps tooling config out of the root and
  // scripts/check-okf.mjs already reaches up into snippets/ from app/.
  "globs": [
    "../*.md",
    "../docs/**/*.md",
    "../snippets/**/*.md",
    "**/*.md"
  ],
  "ignores": [
    // Generated by scripts/build-index.mjs; generated files are exempt.
    "../snippets/**/index.md",
    // Symlinks to AGENTS.md; linting the target once is enough.
    "../**/CLAUDE.md",
    "**/node_modules/**",
    "../**/node_modules/**"
  ],
  "config": {
    // 100 chars, per snippets/code/quality/max-line-length.md. Code blocks
    // and tables are exempt; so are lines whose overflow is one unbreakable
    // token such as a URL, which MD013 allows when strict is off.
    "MD013": {
      "line_length": 100,
      "code_blocks": false,
      "tables": false
    },
    // Snippet bodies start with prose after YAML frontmatter, by design.
    "MD041": false
  }
}
